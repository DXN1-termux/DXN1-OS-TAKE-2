#!/bin/busybox sh
# DXN1-OS real installer — runs from the live environment on REAL hardware.
#
# Three install modes:
#   1) auto-5gb   — create a 5GB partition alongside existing OS (recommended)
#   2) full-wipe  — erase the entire disk and install DXN1-OS as the only OS
#   3) manual     — pick an existing partition and install into it
#
# What it does (for real, using busybox tools):
#   - partitions the disk with fdisk (GPT or MBR)
#   - formats: mkfs.vfat for ESP, mkswap for swap, mkfs.ext2 for root
#   - copies the kernel + initramfs + busybox rootfs onto the target
#   - sets up UEFI boot: copies the kernel (an EFI app via EFI_STUB) to the ESP
#     as /EFI/BOOT/BOOTX64.EFI, so UEFI firmware boots it directly with no
#     extra bootloader (grub/isolinux) required.
#   - writes /etc/fstab, /etc/os-release, installs dxn1-update
#
# After install, reboot -> UEFI firmware loads the kernel from the disk's ESP ->
# kernel mounts the root partition -> /init runs -> DXN1-OS boots from disk.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# --- helpers ---
msg()  { printf "\033[1;32m[i]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[!]\033[0m %s\n" "$1"; }
err()  { printf "\033[1;31m[x]\033[0m %s\n" "$1" >&2; }
ok()   { printf "\033[1;32m[OK]\033[0m %s\n" "$1"; }
die()  { err "$1"; exit 1; }

banner() {
    echo ""
    echo "  ==========================================="
    echo "   DXN1-OS 1.0 'oxide' -- installer"
    echo "   kernel $(uname -r)   (c) DXN1 Project"
    echo "  ==========================================="
    echo ""
}

# --- find the ISO block device (where our rootfs lives) ---
find_iso() {
    # the live ISO is mounted somewhere; find where /bin/busybox comes from
    # in a real live boot the rootfs IS the initramfs (in RAM), so we
    # use the running system's files as the install source.
    ISO_SRC="/run/initramfs"
    if [ ! -d "$ISO_SRC/boot" ]; then
        # fallback: copy from the running initramfs
        ISO_SRC=""
    fi
}

# --- list available disks ---
list_disks() {
    msg "detecting disks..."
    echo ""
    lsblk 2>/dev/null | head -1
    # busybox fdisk -l lists all disks
    for d in /dev/sd[a-z] /dev/nvme[0-9]n[0-9] /dev/mmcblk[0-9]; do
        [ -b "$d" ] || continue
        # show size
        size=$(cat /sys/block/$(basename $d)/size 2>/dev/null)
        if [ -n "$size" ] && [ "$size" -gt 0 ]; then
            # sectors (512B) -> MB
            mb=$(( size / 2 / 1024 ))
            printf "  %-16s %8d MB\n" "$d" "$mb"
        fi
    done
    echo ""
}

# --- pick a disk ---
pick_disk() {
    while true; do
        printf "  enter target disk (e.g. /dev/sda): "
        read disk
        [ -b "$disk" ] && break
        warn "'$disk' is not a block device, try again"
    done
    DISK="$disk"
    # nvme/mmcblk need pN suffix, sd* uses N suffix
    case "$DISK" in
        /dev/nvme*|/dev/mmcblk*) PARTPRE="${DISK}p" ;;
        *)                         PARTPRE="$DISK" ;;
    esac
}

# --- confirm destructive op ---
confirm_wipe() {
    echo ""
    warn "WARNING: this will DESTROY ALL DATA on $DISK"
    warn "Device: $DISK ($(cat /sys/block/$(basename $DISK)/model 2>/dev/null || echo unknown))"
    printf "  type 'yes' to confirm full disk wipe: "
    read ans
    [ "$ans" = "yes" ] || die "aborted by user"
}

# --- mode 1: auto 5GB partition alongside existing OS ---
install_auto_5gb() {
    msg "auto-partition mode: 5GB alongside existing OS"
    list_disks
    pick_disk
    confirm_wipe   # 5gb mode repartitions, so still needs confirmation

    ROOT="${PARTPRE}1"
    msg "creating GPT partition table on $DISK..."
    # create a single 5GB partition (we use the first 5GB)
    # busybox fdisk: o = new GPT-less MBR... we use sfdisk-style via echo
    # GPT via fdisk: g (new GPT), n (new), 1, default, +5G, w
    /bin/busybox fdisk "$DISK" <<EOF
g
n
1

+5G
w
EOF
    [ $? -eq 0 ] || die "partitioning failed"
    ok "created 5GB partition $ROOT"

    # reread partition table
    /bin/busybox blockdev --rereadpt "$DISK" 2>/dev/null || partprobe 2>/dev/null
    sleep 1

    format_and_install "$ROOT" "ext2"
}

# --- mode 2: full disk wipe ---
install_full_wipe() {
    msg "full disk wipe mode"
    list_disks
    pick_disk
    confirm_wipe

    ESP="${PARTPRE}1"
    ROOT="${PARTPRE}2"
    SWAP="${PARTPRE}3"

    msg "wiping $DISK and creating new GPT table..."
    /bin/busybox fdisk "$DISK" <<EOF
g
n
1

+512M
t
1
EFI System
n
2

+1G
t
2
Linux swap
n
3


w
EOF
    [ $? -eq 0 ] || die "partitioning failed"
    /bin/busybox blockdev --rereadpt "$DISK" 2>/dev/null
    sleep 1

    msg "formatting ESP ($ESP) as FAT32..."
    /bin/busybox mkfs.vfat -F 32 -n DXN1EFI "$ESP" || die "mkfs.vfat failed"
    ok "ESP ready"

    msg "formatting swap ($SWAP)..."
    /bin/busybox mkswap -L dxn1swap "$SWAP" || warn "mkswap failed (continuing)"
    ok "swap ready"

    format_and_install "$ROOT" "ext2" "$ESP" "$SWAP"
}

# --- mode 3: manual (pick existing partition) ---
install_manual() {
    msg "manual mode: pick an existing partition"
    list_disks
    printf "  enter root partition (e.g. /dev/sda3): "
    read rp
    [ -b "$rp" ] || die "'$rp' is not a block device"
    ROOT="$rp"
    printf "  format $ROOT as ext2? (yes/no): "
    read fmt
    if [ "$fmt" = "yes" ]; then
        msg "formatting $ROOT as ext2..."
        /bin/busybox mkfs.ext2 -L dxn1root "$ROOT" || die "mkfs.ext2 failed"
        ok "formatted"
    fi
    format_and_install "$ROOT" "ext2" "" ""
}

# --- format root + copy the system + set up UEFI boot ---
# args: $1=root_part  $2=fs_type  [$3=esp_part]  [$4=swap_part]
format_and_install() {
    ROOT="$1"
    FSTYPE="$2"
    ESP="$3"
    SWAP="$4"

    # always (re)format root for a clean install
    msg "formatting root ($ROOT) as $FSTYPE..."
    case "$FSTYPE" in
        ext2) /bin/busybox mkfs.ext2 -L dxn1root "$ROOT" || die "mkfs.ext2 failed" ;;
        ext4) /bin/busybox mkfs.ext4 -L dxn1root "$ROOT" 2>/dev/null || /bin/busybox mkfs.ext2 -L dxn1root "$ROOT" ;;
    esac
    ok "root filesystem ready"

    TARGET="/mnt/dxn1"
    msg "mounting $ROOT at $TARGET..."
    /bin/busybox mkdir -p "$TARGET"
    /bin/busybox mount "$ROOT" "$TARGET" || die "mount failed"

    # --- copy the rootfs from the running initramfs onto the disk ---
    msg "copying DXN1-OS rootfs to disk..."
    /bin/busybox mkdir -p "$TARGET/bin" "$TARGET/sbin" "$TARGET/etc" "$TARGET/boot" \
                          "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/run" \
                          "$TARGET/tmp" "$TARGET/root" "$TARGET/home" "$TARGET/usr/bin" \
                          "$TARGET/usr/sbin" "$TARGET/var" "$TARGET/mnt" "$TARGET/media"

    # copy busybox + all applet symlinks (the entire userspace)
    /bin/busybox cp -a /bin/busybox "$TARGET/bin/"
    # recreate applet symlinks on the target
    for app in sh ash ls cat echo mkdir rmdir rm cp mv mount umount ps kill free \
               uname hostname ifconfig ip ping wget vi head tail grep sed awk sort \
               date sleep env pwd ln chmod chown id whoami dmesg lsmod modprobe \
               insmod depmod switch_root init halt reboot poweroff clear reset \
               stty tty tar gzip gunzip xz unxz find which true false test tr wc \
               cut dd mknod blkid fdisk mkfs.ext2 mkfs.vfat mkswap fsck losetup \
               udevadm mdev sysctl top uptime login getty cttyhack blockdev \
               partprobe; do
        ln -sf /bin/busybox "$TARGET/bin/$app" 2>/dev/null
        ln -sf /bin/busybox "$TARGET/sbin/$app" 2>/dev/null
        ln -sf /bin/busybox "$TARGET/usr/bin/$app" 2>/dev/null
        ln -sf /bin/busybox "$TARGET/usr/sbin/$app" 2>/dev/null
    done
    ok "busybox userspace installed"

    # copy /etc
    /bin/busybox cp -a /etc/* "$TARGET/etc/" 2>/dev/null

    # copy the installed-system init (real root mounter)
    /bin/busybox cp -a /sbin/dxn1-installed-init "$TARGET/sbin/init" 2>/dev/null
    chmod +x "$TARGET/sbin/init" 2>/dev/null

    # copy the installer + updater onto the installed system
    /bin/busybox cp -a /sbin/dxn1-installer "$TARGET/sbin/" 2>/dev/null
    /bin/busybox cp -a /sbin/dxn1-update "$TARGET/sbin/" 2>/dev/null
    chmod +x "$TARGET/sbin/dxn1-installer" "$TARGET/sbin/dxn1-update" 2>/dev/null

    # copy the kernel + initramfs to /boot (for rescue + the updater)
    msg "installing kernel + initramfs to /boot..."
    if [ -f /boot/bzImage ]; then
        /bin/busybox cp -a /boot/bzImage "$TARGET/boot/bzImage"
    elif [ -f /run/initramfs/boot/bzImage ]; then
        /bin/busybox cp -a /run/initramfs/boot/bzImage "$TARGET/boot/bzImage"
    fi
    ok "kernel installed"

    # --- generate fstab ---
    ROOT_UUID=$(/bin/busybox blkid -s UUID -o value "$ROOT" 2>/dev/null)
    {
        echo "# /etc/fstab -- generated by dxn1-installer"
        echo "UUID=$ROOT_UUID  /       $FSTYPE  defaults  0  1"
        if [ -n "$SWAP" ] && [ -b "$SWAP" ]; then
            SWAP_UUID=$(/bin/busybox blkid -s UUID -o value "$SWAP" 2>/dev/null)
            echo "UUID=$SWAP_UUID  swap    swap    pri=1     0  0"
        fi
        echo "proc            /proc   proc    defaults  0  0"
        echo "sysfs           /sys    sysfs   defaults  0  0"
        echo "devtmpfs        /dev    devtmpfs defaults 0  0"
        echo "tmpfs           /tmp    tmpfs   defaults  0  0"
    } > "$TARGET/etc/fstab"
    ok "fstab generated"

    # --- set up UEFI boot via the kernel's EFI_STUB ---
    # The kernel IS a valid EFI application. Copy it to the ESP as BOOTX64.EFI
    # and UEFI firmware will boot it directly — no grub/isolinux needed.
    if [ -n "$ESP" ] && [ -b "$ESP" ]; then
        msg "setting up UEFI boot on ESP ($ESP)..."
        ESP_MNT="$TARGET/boot/efi"
        /bin/busybox mkdir -p "$ESP_MNT"
        /bin/busybox mount "$ESP" "$ESP_MNT"
        /bin/busybox mkdir -p "$ESP_MNT/EFI/BOOT"
        /bin/busybox cp -a "$TARGET/boot/bzImage" "$ESP_MNT/EFI/BOOT/BOOTX64.EFI"
        # write a startup.nsh so UEFI shell auto-boots with the right cmdline
        cat > "$ESP_MNT/startup.nsh" <<EOF
\\EFI\\BOOT\\BOOTX64.EFI root=UUID=$ROOT_UUID init=/sbin/init rw console=tty0 console=ttyS0,115200
EOF
        ok "UEFI boot entry installed (kernel as EFI app)"
        /bin/busybox umount "$ESP_MNT"
    else
        warn "no ESP provided — for UEFI boot, set up the ESP manually"
        warn "or boot from the original USB ISO and re-run the installer."
    fi

    # write an install marker
    {
        echo "DXN1-OS 1.0 'oxide'"
        echo "installed: $(date 2>/dev/null || echo unknown)"
        echo "kernel: $(uname -r)"
        echo "root: $ROOT (UUID=$ROOT_UUID)"
        [ -n "$ESP" ] && echo "esp: $ESP"
        [ -n "$SWAP" ] && echo "swap: $SWAP"
    } > "$TARGET/etc/dxn1-install-info"
    ok "install info written"

    # --- finalize ---
    /bin/busybox sync
    /bin/busybox umount "$TARGET" 2>/dev/null

    echo ""
    ok "DXN1-OS installed successfully!"
    echo ""
    echo "  +---------------------------------------------+"
    echo "  |  DXN1-OS 1.0 installed on $ROOT"
    echo "  |  kernel: $(uname -r)"
    [ -n "$ESP" ] && echo "  |  UEFI boot: ESP $ESP -> BOOTX64.EFI"
    echo "  |"
    echo "  |  next: reboot, remove the USB, and boot from disk."
    echo "  |  run 'dxn1-update' after booting to stay current."
    echo "  +---------------------------------------------+"
    echo ""
    printf "  reboot now? (yes/no, default yes): "
    read rb
    [ "$rb" = "no" ] && return 0
    /bin/busybox sync
    /bin/busybox reboot -f
}

# --- main ---
banner

# if no TTY (e.g. piped), just run live mode
if ! /bin/busybox tty 2>/dev/null | grep -q tty; then
    warn "no interactive TTY; dropping to live shell"
    exec /bin/busybox sh
fi

echo "  Welcome to the DXN1-OS installer."
echo "  This will install DXN1-OS onto a real disk."
echo ""
echo "  Choose an install mode:"
echo "    1) auto-5gb   — create a 5GB partition alongside existing OS (recommended)"
echo "    2) full-wipe  — erase entire disk, install DXN1-OS as the only OS"
echo "    3) manual     — pick an existing partition to install into"
echo "    4) cancel"
echo ""
printf "  mode [1-4]: "
read mode
case "$mode" in
    1) install_auto_5gb ;;
    2) install_full_wipe ;;
    3) install_manual ;;
    4) msg "installation cancelled" ;;
    *) warn "invalid mode; returning to shell"; exec /bin/busybox sh ;;
esac
