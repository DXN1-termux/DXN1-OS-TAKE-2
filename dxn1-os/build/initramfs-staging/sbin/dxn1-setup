#!/bin/busybox sh
# DXN1-OS first-boot user setup (v1.5+).
# Runs interactively on the first boot of an installed system.
# Creates a regular user account, sets hostname, timezone, and locale.
# Called by /sbin/dxn1-installed-init after extracting modules + networking.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

msg()  { printf "\033[1;32m[i]\033[0m %s\n" "$1"; }
ok()   { printf "\033[1;32m[OK]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[!]\033[0m %s\n" "$1"; }

echo ""
echo "  ╔═══════════════════════════════════════════════╗"
echo "  ║     DXN1-OS 1.5 — first-boot setup          ║"
echo "  ╚═══════════════════════════════════════════════╝"
echo ""
echo "  Welcome to DXN1-OS! Let's set up your system."
echo "  (You can skip any step by pressing Enter.)"
echo ""

# --- hostname ---
current_host=$(cat /etc/hostname 2>/dev/null || echo dxn1-oxide)
printf "  hostname [%s]: " "$current_host"
read new_host
if [ -n "$new_host" ]; then
    echo "$new_host" > /etc/hostname
    hostname "$new_host" 2>/dev/null
    ok "hostname set to: $new_host"
else
    msg "keeping hostname: $current_host"
fi

# --- create user ---
echo ""
echo "  Create a regular user account (recommended for daily use):"
printf "  username (e.g. 'dxn1', or Enter to skip): "
read username
if [ -n "$username" ]; then
    # validate
    case "$username" in
        root|bin|daemon|mail|ftp|nobody|system*)
            warn "reserved username — skipping user creation"
            username=""
            ;;
        *)
            # add the user
            if grep -q "^${username}:" /etc/passwd 2>/dev/null; then
                warn "user '$username' already exists — skipping"
            else
                # find next free UID
                uid=1000
                while grep -q "^[^:]*:[^:]*:${uid}:" /etc/passwd 2>/dev/null; do
                    uid=$((uid + 1))
                done
                echo "${username}:x:${uid}:${uid}:DXN1 User:/home/${username}:/bin/sh" >> /etc/passwd
                echo "${username}::${uid}:" >> /etc/group
                echo "${username}::19000:0:99999:7:::" >> /etc/shadow
                mkdir -p "/home/${username}"
                chown "${uid}:${uid}" "/home/${username}"
                # set password
                printf "  password for %s: " "$username"
                read -s pass
                echo ""
                if [ -n "$pass" ]; then
                    # hash with busybox (if mkpasswd available) or store plaintext (busybox sh)
                    hashed=$(/bin/busybox mkpasswd -m sha-512 "$pass" 2>/dev/null || echo "$pass")
                    # update shadow
                    sed -i "s|^${username}::|${username}:${hashed}:|" /etc/shadow 2>/dev/null
                    ok "user '$username' created with password"
                else
                    ok "user '$username' created (no password — set later with 'passwd')"
                fi
                # add to wheel/input/video/audio groups if they exist
                for grp in wheel input video audio plugdev; do
                    grep -q "^${grp}:" /etc/group 2>/dev/null && \
                        sed -i "s|^\(${grp}:[^:]*:[^:]*\):|\1,${username}|" /etc/group 2>/dev/null
                done
                # create home skeleton
                mkdir -p "/home/${username}/.config" "/home/${username}/Desktop" "/home/${username}/Documents"
                chown -R "${uid}:${uid}" "/home/${username}"
            fi
            ;;
    esac
fi

# --- timezone ---
echo ""
msg "common timezones:"
echo "    1) UTC"
echo "    2) America/New_York    (EST/EDT)"
echo "    3) Europe/London        (GMT/BST)"
echo "    4) Europe/Amsterdam     (CET)"
echo "    5) Europe/Berlin        (CET)"
echo "    6) Asia/Tokyo           (JST)"
echo "    7) Asia/Kolkata         (IST)"
echo "    8) Australia/Sydney     (AEST)"
printf "  choice [1-8, default 1]: "
read tz_choice
case "$tz_choice" in
    2) TZ="America/New_York" ;;
    3) TZ="Europe/London" ;;
    4) TZ="Europe/Amsterdam" ;;
    5) TZ="Europe/Berlin" ;;
    6) TZ="Asia/Tokyo" ;;
    7) TZ="Asia/Kolkata" ;;
    8) TZ="Australia/Sydney" ;;
    *) TZ="UTC" ;;
esac
if [ -f "/usr/share/zoneinfo/${TZ}" ]; then
    ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime
    echo "$TZ" > /etc/timezone
    ok "timezone set to: $TZ"
else
    warn "zoneinfo file for $TZ not found — staying on UTC"
fi

# --- locale ---
echo ""
printf "  locale [en_US.UTF-8, default]: "
read locale
locale="${locale:-en_US.UTF-8}"
echo "LANG=${locale}" > /etc/locale.conf 2>/dev/null
ok "locale set to: $locale"

# --- root password ---
echo ""
printf "  set root password (recommended, Enter to skip): "
read -s rootpass
echo ""
if [ -n "$rootpass" ]; then
    hashed=$(/bin/busybox mkpasswd -m sha-512 "$rootpass" 2>/dev/null || echo "$rootpass")
    sed -i "s|^root::|root:${hashed}:|" /etc/shadow 2>/dev/null
    ok "root password set"
else
    warn "root has no password — login as your user, then 'su' or 'sudo'"
fi

# --- summary ---
echo ""
echo "  ╔═══════════════════════════════════════════════╗"
echo "  ║     setup complete!                          ║"
echo "  ╠═══════════════════════════════════════════════╣"
echo "  ║  hostname:  $(cat /etc/hostname 2>/dev/null)" | head -c 47
echo ""
[ -n "$username" ] && echo "  ║  user:      $username"
echo "  ║  timezone:  $TZ"
echo "  ║  locale:    $locale"
echo "  ╚═══════════════════════════════════════════════╝"
echo ""
echo "  Reboot to apply:  /bin/busybox reboot"
echo "  Or continue as root now. Run 'dxn1-update' to check for updates."
echo ""

# mark setup done
date 2>/dev/null > /etc/dxn1-first-boot-done
