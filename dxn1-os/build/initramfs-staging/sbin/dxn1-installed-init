#!/bin/busybox sh
# DXN1-OS installed-system PID 1 init (v1.4+).
# Runs from the real root partition on disk. Does first-boot setup if needed:
#   - extracts kernel modules from /lib/modules/*.tar.gz (if present)
#   - runs dhcpcd to bring up networking
#   - sets hostname/user/locale/timezone (if /etc/dxn1-first-boot exists)
# Then drops to a login shell.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# mount filesystems from /etc/fstab
/bin/busybox mount -o remount,rw / 2>/dev/null
/bin/busybox mount -a 2>/dev/null

# devtmpfs if not already
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null || /bin/busybox mdev -s
/bin/busybox mount -t devpts none /dev/pts 2>/dev/null
/bin/busybox mount -t tmpfs none /tmp 2>/dev/null
/bin/busybox mount -t tmpfs none /run 2>/dev/null

# hostname
[ -f /etc/hostname ] && cat /etc/hostname > /proc/sys/kernel/hostname 2>/dev/null || echo dxn1-oxide > /proc/sys/kernel/hostname 2>/dev/null

# loopback
/bin/busybox ip link set lo up 2>/dev/null

# swapon
/bin/busybox swapon -a 2>/dev/null

# --- first-boot setup (v1.4+: modules + networking; v1.5+: user setup) ---
if [ ! -f /etc/dxn1-first-boot-done ]; then
    echo "[dxn1-init] first-boot setup..."

    # extract kernel modules if bundled (ISO stores it as /lib/modules/MODULES_TARGZ)
    for modpkg in /lib/modules/MODULES_TARGZ /lib/modules/*.tar.gz; do
        [ -f "$modpkg" ] || continue
        KVER="5.10.0-32-amd64"
        echo "[dxn1-init] extracting kernel modules ($KVER)..."
        mkdir -p "/lib/modules/$KVER"
        tar xzf "$modpkg" -C "/lib/modules/$KVER" 2>/dev/null
        /bin/busybox depmod -a "$KVER" 2>/dev/null || /bin/busybox depmod "$KVER" 2>/dev/null
        echo "[dxn1-init] modules extracted; modprobe now works"
    done

    # load essential driver modules
    for mod in e1000 e1000e igb r8169 tg3 sky2 alx iwlwifi ath9k ath10k brcmfmac \
               snd-hda-intel snd-usb-audio amdgpu nouveau i915 ahci nvme usb-storage \
               ext4 vfat fuse; do
        /bin/busybox modprobe "$mod" 2>/dev/null && echo "[dxn1-init] loaded: $mod"
    done

    # bring up networking (DHCP) on the first non-loopback interface
    for iface in /sys/class/net/*; do
        name=$(basename "$iface")
        [ "$name" = "lo" ] && continue
        echo "[dxn1-init] configuring network on $name (DHCP)..."
        /bin/busybox ip link set "$name" up 2>/dev/null
        /bin/busybox udhcpc -i "$name" -q -t 5 2>/dev/null && break
    done

    # v1.5+: run interactive user setup (creates user, sets hostname/tz/locale)
    if [ -x /sbin/dxn1-setup ]; then
        echo "[dxn1-init] launching first-boot user setup..."
        /sbin/dxn1-setup
    else
        # write the marker so this only runs once
        date 2>/dev/null > /etc/dxn1-first-boot-done
        echo "[dxn1-init] first-boot setup complete"
    fi
fi

# start udev for hotplug (if available)
if [ -x /sbin/udevd ]; then
    /sbin/udevd --daemon 2>/dev/null
    /sbin/udevadm trigger 2>/dev/null
fi

# clean up stale files
/bin/busybox rm -rf /tmp/* /var/run/* /var/lock/* 2>/dev/null
/bin/busybox mkdir -p /var/run /var/lock /var/log 2>/dev/null

# banner
cat <<'BANNER'


  ____  _  _   _   _  ___  _   _  ___
 |  _ \| || | /_\ | \| |/ __|| | | |/ __|
 | | | | __ |/ _ \| .` |\__ \| |_| | (_ |
 |_| |_||_/_/ \_\_|\_|___(_)___/ \___|

BANNER
echo "  DXN1-OS 1.4 'kernel' (installed)  kernel $(uname -r)"
echo ""
[ -f /etc/dxn1-first-boot-done ] && echo "  first-boot setup: complete" || echo "  first-boot setup: pending"
echo "  run 'dxn1-update' to check for OS updates."
echo "  run 'modprobe <name>' to load kernel modules (314 available)."
echo "  run 'dxn1-pkg install <pkg>' to install software."
echo ""

# drop to login shell
echo "dxn1-oxide login: root (auto-login)"
exec setsid -c /bin/busybox cttyhack /bin/busybox sh
