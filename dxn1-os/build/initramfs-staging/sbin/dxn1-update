#!/bin/busybox sh
# DXN1-OS auto-updater.
#
# Checks the DXN1-OS GitHub releases for a newer version. If found, downloads
# the new kernel + initramfs, verifies the sha256, installs them to /boot and
# refreshes the UEFI boot entry (copies the new kernel to the ESP as
# BOOTX64.EFI), then prompts to reboot.
#
# Usage:
#   dxn1-update               # interactive check + install
#   dxn1-update --check      # check only, don't install
#   dxn1-update --force       # reinstall even if already current
#
# Works on the INSTALLED system (runs from disk root, not the live ISO).
# On the live ISO, reports the current version only.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# --- config ---
REPO="DXN1-termux/DXN1-OS-TAKE-2"        # the real GitHub repo
API="https://api.github.com/repos/${REPO}/releases/latest"
DL_BASE="https://github.com/${REPO}/releases/latest/download"
CURRENT_VERSION="1.5"
STATE_DIR="/var/lib/dxn1-update"
mkdir -p "$STATE_DIR" 2>/dev/null

msg()  { printf "\033[1;32m[i]\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m[!]\033[0m %s\n" "$1"; }
err()  { printf "\033[1;31m[x]\033[0m %s\n" "$1" >&2; }
ok()   { printf "\033[1;32m[OK]\033[0m %s\n" "$1"; }

# --- detect if running from the installed system or live ISO ---
is_installed() {
    [ -f /etc/dxn1-install-info ] && return 0
    # also: if /boot/bzImage is on a real disk (not in initramfs RAM)
    /bin/busybox mount 2>/dev/null | grep -q ' / ' | grep -q -v 'rootfs\|tmpfs\|initramfs' && return 0
    return 1
}

# --- current version ---
get_current() {
    if [ -f /etc/dxn1-version ]; then
        cat /etc/dxn1-version
    elif [ -f /etc/dxn1-install-info ]; then
        grep -o 'version=[^ ]*' /etc/dxn1-install-info | cut -d= -f2
    else
        echo "$CURRENT_VERSION"
    fi
}

# --- fetch latest version string from GitHub API ---
get_latest() {
    # busybox wget the API JSON, extract tag_name
    /bin/busybox wget -q -O /tmp/dxn1-release.json "$API" 2>/dev/null
    if [ ! -s /tmp/dxn1-release.json ]; then
        echo ""
        return
    fi
    # crude JSON parse for "tag_name":"vX.Y"
    /bin/busybox grep -o '"tag_name":"[^"]*"' /tmp/dxn1-release.json 2>/dev/null | \
        /bin/busybox head -1 | /bin/busybox sed 's/"tag_name":"\(.*\)"/\1/'
}

# --- download + verify a file ---
# $1 = filename, $2 = output path
fetch_verify() {
    local fn="$1"
    local out="$2"
    msg "downloading $fn..."
    /bin/busybox wget -q -O "$out" "${DL_BASE}/${fn}" 2>/dev/null
    if [ ! -s "$out" ]; then
        err "download failed: $fn"
        return 1
    fi
    # download the sha256 sidecar
    /bin/busybox wget -q -O "${out}.sha256" "${DL_BASE}/${fn}.sha256" 2>/dev/null
    if [ -s "${out}.sha256" ]; then
        expected=$(/bin/busybox awk '{print $1}' "${out}.sha256")
        actual=$(/bin/busybox sha256sum "$out" | /bin/busybox awk '{print $1}')
        if [ "$expected" != "$actual" ]; then
            err "sha256 mismatch for $fn"
            err "  expected: $expected"
            err "  actual:   $actual"
            /bin/busybox rm -f "$out" "${out}.sha256"
            return 1
        fi
        ok "verified $fn (sha256 OK)"
    else
        warn "no sha256 sidecar for $fn — skipping verification"
    fi
    return 0
}

# --- main ---
CHECK_ONLY=0
FORCE=0
case "${1:-}" in
    --check) CHECK_ONLY=1 ;;
    --force) FORCE=1 ;;
    --help|-h)
        echo "usage: dxn1-update [--check|--force|--help]"
        echo ""
        echo "  (no arg)   check + install updates interactively"
        echo "  --check    check only, report if an update is available"
        echo "  --force    reinstall even if already current"
        exit 0
        ;;
esac

echo ""
echo "  DXN1-OS auto-updater"
echo "  ====================="
echo ""

CURRENT=$(get_current)
msg "current version: $CURRENT"

# running from live ISO?
if ! is_installed; then
    warn "running from the live ISO — updates apply to an installed system."
    warn "install DXN1-OS first (run 'dxn1-installer'), then run 'dxn1-update'."
    echo ""
    msg "to check the latest release online, see:"
    echo "    https://github.com/${REPO}/releases"
    exit 0
fi

msg "checking for updates..."
LATEST=$(get_latest)
if [ -z "$LATEST" ]; then
    err "could not reach the update server (no network, or repo not yet published)."
    err "once the GitHub repo exists and has releases, this will work."
    echo ""
    echo "  set your repo name in /sbin/dxn1-update (REPO variable)"
    echo "  then re-run: dxn1-update"
    exit 1
fi
msg "latest release:  $LATEST"

# strip leading 'v' for comparison
LATEST_NUM=$(echo "$LATEST" | /bin/busybox sed 's/^v//')
if [ "$LATEST_NUM" = "$CURRENT" ] && [ "$FORCE" != "1" ]; then
    ok "already up to date ($CURRENT)"
    [ "$CHECK_ONLY" = "1" ] && exit 0
    exit 0
fi

if [ "$CHECK_ONLY" = "1" ]; then
    if [ "$LATEST_NUM" != "$CURRENT" ]; then
        warn "update available: $CURRENT -> $LATEST"
        echo "  run 'dxn1-update' (without --check) to install."
    fi
    exit 0
fi

echo ""
warn "an update is available: $CURRENT -> $LATEST"
printf "  download and install? (yes/no): "
read ans
[ "$ans" = "yes" ] || { msg "update cancelled"; exit 0; }

# --- download new kernel + initramfs ---
TMP="$STATE_DIR/staging"
/bin/busybox mkdir -p "$TMP"
/bin/busybox rm -rf "$TMP"/*

if ! fetch_verify "bzImage" "$TMP/bzImage"; then
    err "failed to fetch kernel; aborting"
    exit 1
fi
if ! fetch_verify "initramfs.img" "$TMP/initramfs.img"; then
    err "failed to fetch initramfs; aborting"
    exit 1
fi

# --- backup current ---
msg "backing up current kernel + initramfs..."
/bin/busybox cp -a /boot/bzImage /boot/bzImage.old 2>/dev/null
/bin/busybox cp -a /boot/initramfs.img /boot/initramfs.img.old 2>/dev/null

# --- install new ---
msg "installing new kernel + initramfs to /boot..."
/bin/busybox cp -a "$TMP/bzImage" /boot/bzImage
/bin/busybox cp -a "$TMP/initramfs.img" /boot/initramfs.img

# refresh UEFI boot entry (copy new kernel to ESP)
ESP=$(/bin/busybox mount | /bin/busybox grep '/boot/efi' | /bin/busybox awk '{print $1}')
if [ -n "$ESP" ]; then
    msg "refreshing UEFI boot entry on $ESP..."
    /bin/busybox mount -o remount,rw "$ESP" 2>/dev/null
    ESP_MNT="/boot/efi"
    /bin/busybox mkdir -p "$ESP_MNT/EFI/BOOT"
    /bin/busybox cp -a /boot/bzImage "$ESP_MNT/EFI/BOOT/BOOTX64.EFI"
    ok "UEFI boot entry updated"
else
    warn "ESP not mounted at /boot/efi — skipping boot entry refresh"
    warn "if you use UEFI, mount the ESP and copy /boot/bzImage to EFI/BOOT/BOOTX64.EFI"
fi

# update version marker
echo "$LATEST_NUM" > /etc/dxn1-version
ok "version updated to $LATEST"

/bin/busybox sync
echo ""
ok "update complete!"
echo ""
echo "  +---------------------------------------------+"
echo "  |  DXN1-OS updated: $CURRENT -> $LATEST"
echo "  |  kernel: $(/bin/busybox uname -r)"
echo "  |"
echo "  |  old kernel backed up to /boot/bzImage.old"
echo "  |  (restore by copying it back if the new one fails)"
echo "  |"
echo "  |  reboot to boot the updated system."
echo "  +---------------------------------------------+"
echo ""
printf "  reboot now? (yes/no, default no): "
read rb
[ "$rb" = "yes" ] && /bin/busybox reboot -f
exit 0
