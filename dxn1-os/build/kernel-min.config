# DXN1-OS minimal real-kernel config fragment
# Built on top of make tinyconfig — enables just enough to boot to a busybox shell
# from an initramfs, on UEFI firmware via EFI_STUB, and on common emulators
# (QEMU, VirtualBox) and real UEFI PCs.

# === 64-bit x86 ===
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y

# === Print enough to actually see what's happening ===
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FB=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_PRINTK_TIME=y

# === Initramfs + userspace ===
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""

# === EFI boot (kernel boots directly from UEFI firmware, no bootloader needed) ===
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFI_ESRT=y
CONFIG_EFI_RUNTIME_WRAPPERS=y

# === Filesystems for the ISO + initramfs ===
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVPTS_FS=y
CONFIG_FHANDLE=y

# === Block / disk — virtio + AHCI + IDE + USB + ramdisk ===
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_VIRTIO_BLK=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_PATA_AMD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# === PCI (needed for AHCI/virtio/enumeration) ===
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# === virtio for QEMU/VirtualBox ===
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# === Real-time clock + ACPI ===
CONFIG_ACPI=y
CONFIG_HPET_TIMER=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# === Input (keyboard) ===
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# === ELF binaries (so busybox runs) ===
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# === Kernel module support (so we could load modules later) ===
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# === Crypto basics busybox needs ===
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y

# === Misc needed for boot ===
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KALLSYMS=y
CONFIG_BPF=y

# === Disable stuff to keep it tiny + fast ===
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set  (we keep USB above actually)
# CONFIG_WIRELESS is not set
# CONFIG_DRM is not set
# CONFIG_NET is not set  (we DO want net for busybox network toys — enable it)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y

# === Avoid build noise ===
# CONFIG_DEBUG_INFO is not set
# CONFIG_KASAN is not set
